# 로컬 개발용 환경 변수 (이 파일을 .env.local로 복사해서 채운다)
DATABASE_URL=postgres://사용자@localhost:5432/blogville

# Better Auth
BETTER_AUTH_SECRET=openssl rand -base64 32 로 생성
BETTER_AUTH_URL=http://localhost:3000

# 소셜 로그인 (각 개발자 센터에서 발급받아 채운다. ID와 SECRET이 둘 다 있는 서비스만 켜진다)
# 개발자 센터에 등록할 콜백 주소: {BETTER_AUTH_URL}/api/auth/callback/google (kakao, naver도 같은 꼴)
# 배포 서버는 GitHub → Settings → Secrets and variables → Actions의 같은 이름 secret을 쓴다
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 관리자 계정 (npm run admin:create 로 생성·갱신)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# 글 첨부(사진·파일) 저장 폴더. 비우면 storage/uploads (git에 올리지 않는다)
UPLOAD_DIR=
