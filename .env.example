# 로컬 개발용 환경 변수 (이 파일을 .env.local로 복사해서 채운다)
DATABASE_URL=postgres://사용자@localhost:5432/blogville

# Better Auth
BETTER_AUTH_SECRET=openssl rand -base64 32 로 생성
BETTER_AUTH_URL=http://localhost:3000

# 소셜 로그인 (각 개발자 센터에서 발급받아 채운다)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 관리자 계정 (npm run admin:create 로 생성·갱신)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
